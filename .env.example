# remuda environment — copy to .env and fill in your own values.
#
# remuda never stores a credential in a file it reads. A provider declares
# `key_env: THE_VARIABLE_NAME` in providers.yaml, and the key is read from the
# environment at call time. NEVER commit a real key: this file lists NAMES.

# --- Zero-config bootstrap -------------------------------------------------
# Set this and remuda self-configures, with no registry files at all: an
# implicit `openrouter` provider and a `free` pool discovered from its free
# tier. An explicit registry entry of the same name always overrides it.
OPENROUTER_API_KEY=

# Turn the whole environment bootstrap off (any non-empty value). Same effect
# as passing --no-bootstrap. A local model server answering on 127.0.0.1:11434
# is detected by a TCP probe, not by a variable, and this switch disables that
# detection too.
# REMUDA_NO_BOOTSTRAP=1

# Point the user-level registry layer somewhere other than
# ~/.config/remuda. The project layer (./.remuda) is unaffected.
# REMUDA_CONFIG_DIR=./.remuda

# --- Your own providers' keys ----------------------------------------------
# One variable per provider that needs a credential, named by that provider's
# `key_env` in providers.yaml. These are examples — use whatever names your
# own registry declares.
# OPENAI_API_KEY=
# TOGETHER_API_KEY=
#
# A local server (Ollama, vLLM) usually needs no key: leave `key_env` unset on
# that provider rather than exporting an empty variable.
